# Rust build artifacts
/target/
**/*.rs.bk

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store
._*

# Installer build output
installers/*.exe
installers/*.msi

# Release directories (contain separate git repos / temp build artifacts)
/release/
/release_tmp/
/release_smoke/

# Temporary files
*.tmp
*.log
*.obj

# Generated C output
*.out

# Stray build artifacts in root
/enterprise.*
/server.*

# Site example binaries & downloads
examples/site/main.c
examples/site/main.exe
examples/site/downloads/*.exe

# Junk files
*head -30*
