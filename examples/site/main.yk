    line("    --color-accent: #0097fc4f;");
    line("    --color-bg: #333;");
    line("    --color-bg-secondary: #555;");
    line("    --color-link: #0097fc;");
    line("    --color-secondary: #e20de9;");
    line("    --color-secondary-accent: #e20de94f;");
    line("    --color-shadow: #bbbbbb20;");
    line("    --color-table: #0097fc;");
    line("    --color-text: #f7f7f7;");
    line("    --color-text-secondary: #aaa;");
    line("  }");
    line("}");
    line("");
    line("html {");
    line("  scroll-behavior: smooth;");
    line("}");
    line("");
    line("@media (prefers-reduced-motion: reduce) {");
    line("  html {");
    line("    scroll-behavior: auto;");
    line("  }");
    line("}");
    line("");
    line("/* Layout */");
    line("article aside {");
    line("  background: var(--color-secondary-accent);");
