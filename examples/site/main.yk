    line("  left: -2px;");
    line("  padding: 0.5rem 1rem;");
    line("  position: absolute;");
    line("  top: 1.7rem;");
    line("  white-space: nowrap;");
    line("  width: auto;");
    line("  z-index: 1;");
    line("}");
    line("");
    line("nav ul li ul::before {");
    line("  /* fill gap above to make mousing over them easier */");
    line("  content: '';");
    line("  position: absolute;");
    line("  left: 0;");
    line("  right: 0;");
    line("  top: -0.5rem;");
    line("  height: 0.5rem;");
    line("}");
    line("");
    line("nav ul li ul li,");
    line("nav ul li ul li a {");
    line("  display: block;");
    line("}");
    line("");
    line("/* Nav for Mobile */");
