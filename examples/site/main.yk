    line("<div class='eyebrow'>Download</div>");
    line("<h2>Get York</h2>");
    line("<div class='relband'>v1.1.0 · Windows x64 <b>available</b> · Linux x86_64 &amp; arm64 <b>available</b> · SHA-256 verified · macOS on the way</div>");
    line("<div class='download'>");
