    line("");
    line(":root {");
    line("  --active-brightness: 0.85;");
    line("  --border-radius: 5px;");
    line("  --box-shadow: 2px 2px 10px;");
    line("  --color-accent: #118bee15;");
    line("  --color-bg: #fff;");
    line("  --color-bg-secondary: #e9e9e9;");
    line("  --color-link: #118bee;");
