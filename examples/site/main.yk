}

public static void cli() {
    line("<section id='cli'>");
    line("<div class='eyebrow'>Cheat sheet</div>");
    line("<h2>The whole CLI on one card</h2>");
    line("<p class='desc'>Seven commands cover the entire workflow — desktop and mobile.</p>");
    line("<div class='grid'>");
    cheat("york new NAME", "Scaffold a fresh project with a starter main.yk.");
    cheat("york build", "Compile the current project to a native binary.");
    cheat("york run FILE", "Compile and run a York source file in one step.");
    cheat("york dev", "Watch your files and rebuild &amp; re-run on every save.");
    cheat("york new-mobile NAME", "Scaffold a mobile app — PWA + Android + iOS from one source.");
    cheat("york mobile APP --platform both --apk", "Build the app, then compile a real signed .apk with York's own toolchain (no Gradle, no Android Studio).");
    cheat("york --version", "Confirm which York you are running.");
    line("</div>");
    line("</section>");
}

// ---------------------------------------------------------------------------
// faq
// ---------------------------------------------------------------------------
public static void qa(String q, String a) {
    line("<details>");
    line("<summary>" + q + "</summary>");
    line("<p>" + a + "</p>");
    line("</details>");
}

public static void faq() {
    line("<section id='faq' class='faq'>");
    line("<div class='eyebrow'>FAQ</div>");
    line("<h2>Questions, answered</h2>");
    qa("Do I need anything else installed?", "No. York ships as a prebuilt native binary — the installer just puts it on your PATH. Nothing else to install, nothing dangling.");
    qa("How does York handle memory?", "Arena memory with value semantics: data lives in fast stack-like arenas, you read copies, and mutation is explicit. No garbage collector, no ceremony.");
    qa("Is York production-ready?", "1.1.0 is early but real: structs, impls, enums with switch, arrays, and file I/O all compile fast to native code. More libraries are on the roadmap.");
    qa("Can York run in the browser?", "Soon. The browser backend is in progress, and it compiles the same York source you run natively.");
    qa("How do I uninstall York?", "Delete the install directory — %LOCALAPPDATA%\\Programs\\york on Windows, ~/.york on macOS and Linux — and remove the PATH entry the installer added. Two steps, done.");
    qa("Is this website written in York?", "Yes. This page is generated by a York program — the whole layout, every word, and the scripts. The generator lives in this site's repository.");
    qa("Is York open source?", "This distribution ships free, prebuilt binaries. The compiler source stays private.");
    line("</section>");
}

