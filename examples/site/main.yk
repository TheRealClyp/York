public static void qstep(String num, String text, String cmd) {
    line("<div class='step'>");
    line("<div class='num'>" + num + "</div>");
    line("<div>");
    line("<p>" + text + "</p>");
    line("<div class='cmdrow'><pre>" + cmd + "</pre><button class='copy' type='button'>copy</button></div>");
    line("</div>");
    line("</div>");
}

public static void quickstart() {
    line("<section id='quickstart'>");
    line("<div class='eyebrow'>Quickstart</div>");
    line("<h2>Hello, York — in three steps</h2>");
    line("<p class='desc'>Install once, then this is the whole flow. No build files to hand-edit.</p>");
    line("<div class='qs'>");
    qstep("1", "Scaffold a project. York drops a starter <code class='inline'>main.yk</code> you can open and edit.", "york new hello");
    qstep("2", "Step inside and write some code.", "cd hello");
    qstep("3", "Compile to native and run — the whole loop is one command.", "york run main.yk");
    line("</div>");
    line("<div class='term'>");
    line("<div class='tbar'>");
    line("<span class='dot' style='background:#ff5f56'></span>");
    line("<span class='dot' style='background:#ffbd2e'></span>");
    line("<span class='dot' style='background:#27c93f'></span>");
    line("<span class='name'>hello</span>");
    line("</div>");
    line("<pre>");
    line("<span class='dim'>$</span> york run main.yk");
    line("<span class='dim'>compiling hello ...</span>");
    line("<span class='out'>Hello, York!</span>");
    line("<span class='dim'>$</span>");
    line("</pre>");
    line("</div>");
    line("</section>");
}

