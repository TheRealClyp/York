// York site generator — builds the York landing page into index.html.
// Run:  york run
// This page is generated by York itself.

public static void line(String text) {
    append_file("index.html", text);
    append_file("index.html", "\n");
}

// ---------------------------------------------------------------------------
// <head>  —  meta, fonts, and the whole design system
// ---------------------------------------------------------------------------
public static void head() {
    line("<!DOCTYPE html>");
    line("<html lang='en' color-mode='user'>");
    line("<head>");
    line("<meta charset='utf-8'>");
    line("<meta name='viewport' content='width=device-width, initial-scale=1'>");
    line("<title>York — a fast, simple systems language</title>");
    line("<meta name='description' content='York is a fast, simple systems language: clean syntax, arena memory, and a single native binary. No runtime, no garbage collector. Free Windows + Linux binaries.'>");
    line("<meta name='theme-color' content='#ffffff'>");
    line("<link rel='canonical' href='https://therealclyp.github.io/York-Website/'>");
    line("<meta property='og:type' content='website'>");
    line("<meta property='og:url' content='https://therealclyp.github.io/York-Website/'>");
    line("<meta property='og:site_name' content='York'>");
    line("<meta property='og:title' content='York — one language, zero magic'>");
    line("<meta property='og:description' content='Fast, simple systems language. Clean syntax, arena memory, single native binary. Free Windows + Linux binaries.'>");
    line("<link rel='icon' href='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%2304070d%22/><text x=%2250%22 y=%2268%22 font-size=%2260%22 text-anchor=%22middle%22 fill=%22%2322d3ee%22 font-family=%22monospace%22 font-weight=%22800%22>Y</text></svg>'>");
    line("<style>");
    line("/* MVP.css v1.18 - MIT License - github.com/andybrewer/mvp - base stylesheet */");
