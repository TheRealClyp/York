public static void nav() {
    line("<nav class='nav' id='nav'>");
    line("<a class='logo' href='#top'>" + "<svg xmlns='http://www.w3.org/2000/svg' width='28' height='28' viewBox='0 0 100 100' style='vertical-align:-6px'><rect width='100' height='100' rx='22' fill='#1a5dff'/><text x='50' y='70' font-size='58' text-anchor='middle' fill='#ffffff' font-family='monospace' font-weight='800'>Y</text></svg>" + "York<span class='dot'>.</span></a>");
    line("<div class='links' id='links'>");
    line("<a href='#features'>Features</a>");
    line("<a href='#code'>Code</a>");
    line("<a href='#learn'>Learn</a>");
    line("<a href='#quickstart'>Quickstart</a>");
    line("<a href='#install'>Install</a>");
    line("<a href='#cli'>CLI</a>");
    line("<a href='#faq'>FAQ</a>");
    line("</div>");
    line("<div class='spacer'></div>");
    line("<span class='ver'>v1.1.0</span>");
    line("<a class='cta' href='#install'>Get York</a>");
    line("<button class='burger' id='burger' type='button' aria-label='Menu'>☰</button>");
    line("</nav>");
}

// ---------------------------------------------------------------------------
// hero
// ---------------------------------------------------------------------------
public static void hero() {
    line("<main id='top'>");
    line("<div class='hero'>");
    line("<span class='kicker'>YORK <em>v1.1.0</em> · OUT NOW <b>· FREE BINARIES</b></span>");
    line("<h1>One language.<br><span class='grad'>Zero magic.</span></h1>");
    line("<p class='lead'>York is a fast, simple systems language. Clean syntax, arena memory, and a single native binary — no runtime, no garbage collector, no surprises.</p>");
    line("<div class='buttons'>");
    line("<a class='btn primary' href='#install'>Get York for your OS</a>");
    line("<a class='btn ghost' href='#code'>See the code</a>");
    line("</div>");
    line("<div class='chips'>");
    line("<span class='chip'>latest <b>v1.1.0</b></span>");
    line("<span class='chip'>Windows <b>x64 · Linux x86_64 &amp; arm64</b> — macOS soon</span>");
    line("<span class='chip'>zero <b>dependencies</b> at runtime</span>");
    line("<span class='chip'>free <b>binaries</b>, no sign-up</span>");
    line("</div>");
    line("<div class='term'>");
    line("<div class='tbar'>");
    line("<span class='dot' style='background:#ff5f56'></span>");
    line("<span class='dot' style='background:#ffbd2e'></span>");
    line("<span class='dot' style='background:#27c93f'></span>");
    line("<span class='name'>hello.yk — york run main.yk</span>");
    line("</div>");
    line("<pre id='heroterm' aria-label='Live York demo'></pre>");
    line("</div>");
    line("</div>");
}

