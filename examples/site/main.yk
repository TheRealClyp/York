    line("<p class='dlsmall' id='dlhint'>Your OS is auto-detected. Grab the installer or the portable archive.</p>");
    line("<div class='dlrow'>");
    line("<a class='mini' href='downloads/york-setup-x64.exe'>Windows .exe</a>");
    line("<a class='mini' href='downloads/york-x86_64-windows.zip'>Windows .zip</a>");
    line("<a class='mini' href='downloads/york-x86_64-linux.tar.gz'>Linux .tar.gz</a>");
    line("<a class='mini' href='downloads/york.exe'>york.exe</a>");
    line("<a class='mini' href='downloads/SHASUMS256.txt'>checksums</a>");
    line("</div>");
    line("</div>");
    line("<div class='ostabs'>");
    line("<button class='osbtn active' data-os='windows' type='button'>Windows</button>");
    line("<button class='osbtn' data-os='macos' type='button'>macOS</button>");
    line("<button class='osbtn' data-os='linux' type='button'>Linux</button>");
    line("<button class='osbtn' data-os='more' type='button'>Release notes</button>");
    line("</div>");
    // windows
    line("<div class='pane active' data-os='windows'>");
    line("<h3>Windows — everything you need</h3>");
    line("<p class='note'>The installer is the node-style route — double-click, live progress, PATH added, self-verifying. The archive and single-file build are portable.</p>");
    line("<table class='dltable'>");
    line("<tr><th>Artifact</th><th>Why you want it</th><th>Size</th><th></th></tr>");
    line("<tr><td><b>york-setup-x64.exe</b></td><td>GUI installer — live progress, adds PATH, verifies itself<span class='sub'>recommended</span></td><td class='sz'>~ 0.9 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york-setup-x64.exe'>Download</a></div></td></tr>");
    line("<tr><td><b>york-x86_64-windows.zip</b></td><td>Portable — unzip and run <code class='inline'>bin\\york.exe</code><span class='sub'>no install, no PATH changes</span></td><td class='sz'>~ 0.5 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york-x86_64-windows.zip'>Download</a></div></td></tr>");
    line("<tr><td><b>york.exe</b></td><td>Single-file executable — download and run<span class='sub'>simplest possible start</span></td><td class='sz'>~ 1.3 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york.exe'>Download</a></div></td></tr>");
    line("<tr><td>SHASUMS256.txt</td><td>Verified SHA-256 checksums for everything above<span class='sub'>pinned, no mirrors</span></td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='downloads/SHASUMS256.txt'>View</a></div></td></tr>");
    line("</table>");
    line("<div style='height:18px'></div>");
    line("<p class='note'>Or pipe one line and let the installer take over:</p>");
    line("<div class='cmdrow'><pre>irm https://raw.githubusercontent.com/TheRealClyp/York/main/installers/install.ps1 | iex</pre><button class='copy' type='button'>copy</button></div>");
    line("<p class='note' style='margin-top:12px'>Installs to <code class='inline'>%LOCALAPPDATA%\\Programs\\york</code> and adds it to your PATH. 32-bit and ARM64 installers ship with the next release — the compiler already builds clean on both.</p>");
    line("</div>");
    // macos
    line("<div class='pane' data-os='macos'>");
    line("<h3>macOS — command is ready, binary on the way</h3>");
    line("<p class='note'>Binary must be produced on a Mac — there is no way to build it from a Windows machine. The moment the universal build lands it appears right here, SHA-256 verified like everything else, and installs to <code class='inline'>~/.york/bin</code>.</p>");
    line("<div class='cmdrow'><pre>curl -fsSL https://raw.githubusercontent.com/TheRealClyp/York/main/installers/install.sh | sh</pre><button class='copy' type='button'>copy</button></div>");
    line("<p class='note' style='margin-top:12px'>The installer is ready — it is waiting on the binaries. <a class='mini' href='https://github.com/TheRealClyp/York/releases'>Watch releases</a></p>");
    line("</div>");
    // linux
    line("<div class='pane' data-os='linux'>");
    line("<h3>Linux — static binaries for x86_64 &amp; arm64</h3>");
    line("<p class='note'>Fully static builds — zero glibc dependency — so they run on every Linux distro, musl and Alpine included. The one-line installer detects your architecture automatically.</p>");
    line("<table class='dltable'>");
    line("<tr><th>Artifact</th><th>Why you want it</th><th>Size</th><th></th></tr>");
    line("<tr><td><b>york-x86_64-linux.tar.gz</b></td><td>Portable — extract and run <code class='inline'>bin/york</code><span class='sub'>static · no install, no PATH changes</span></td><td class='sz'>~ 0.6 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york-x86_64-linux.tar.gz'>Download</a></div></td></tr>");
    line("<tr><td><b>york-aarch64-linux.tar.gz</b></td><td>ARM64 — Raspberry Pi 4/5, Ampere, Graviton<span class='sub'>static · same compiler, same everything</span></td><td class='sz'>~ 0.6 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york-aarch64-linux.tar.gz'>Download</a></div></td></tr>");
    line("<tr><td><b>install.sh</b></td><td>One-line installer — auto-detects your arch &amp; OS<span class='sub'>curl • pipe • sh</span></td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='installers/install.sh'>View</a></div></td></tr>");
    line("</table>");
    line("<div style='height:18px'></div>");
    line("<p class='note'>Or pipe one line and let the installer take over:</p>");
    line("<div class='cmdrow'><pre>curl -fsSL https://raw.githubusercontent.com/TheRealClyp/York/main/installers/install.sh | sh</pre><button class='copy' type='button'>copy</button></div>");
    line("<p class='note' style='margin-top:12px'>Installs to <code class='inline'>~/.york/bin</code> and adds it to your PATH. Building a program needs a C compiler (<code class='inline'>gcc</code>/<code class='inline'>clang</code>/<code class='inline'>cc</code>).</p>");
    line("</div>");
    // more
    line("<div class='pane' data-os='more'>");
    line("<h3>Release notes</h3>");
    line("<p class='note'>This distribution ships prebuilt binaries only — the compiler source is not part of the public release.</p>");
    line("<table class='dltable'>");
    line("<tr><th>Item</th><th>Notes</th><th>Size</th><th></th></tr>");
    line("<tr><td><b>install.ps1</b></td><td>One-line installer used by the pipe commands above</td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='installers/install.ps1'>Open</a></div></td></tr>");
    line("<tr><td><b>install.sh</b></td><td>Shell installer for macOS &amp; Linux — fully working with the x86_64 Linux build today</td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='installers/install.sh'>Open</a></div></td></tr>");
    line("<tr><td><b>CHANGELOG.md</b></td><td>What changed in each York release</td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='CHANGELOG.md'>View</a></div></td></tr>");
    line("<tr><td><b>GitHub Releases</b></td><td>Binaries, checksums, and release notes</td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='https://github.com/TheRealClyp/York/releases'>Open</a></div></td></tr>");
    line("</table>");
    line("</div>");
    line("<p class='sha'>Every artifact is signed and verified against its <a href='downloads/SHASUMS256.txt'>SHA-256 checksums</a> — served directly from this site, no mirrors.</p>");
    line("</section>");
}

