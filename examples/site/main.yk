// ---------------------------------------------------------------------------
// site.js — interactions, OS detection, typing demo, tabs, copy, reveal
// ---------------------------------------------------------------------------
public static void j(String text) {
    append_file("site.js", text);
    append_file("site.js", "\n");
}

public static void scripts() {
    write_file("site.js", "");
    j("(function () {");
    j("'use strict';");
    j("var NL = String.fromCharCode(10);");
    j("");
    j("/* ---------- OS detection ---------- */");
    j("function os() {");
    j("  var u = (navigator.userAgent || '').toLowerCase();");
    j("  if (/windows|win32|win64/.test(u)) return 'windows';");
    j("  if (/macintosh|mac os x/.test(u)) return 'macos';");
    j("  return 'linux';");
    j("}");
    j("var OS = os();");
    j("");
    j("/* ---------- platform panes ---------- */");
    j("var panes = Array.prototype.slice.call(document.querySelectorAll('.pane[data-os]'));");
    j("var osbtns = Array.prototype.slice.call(document.querySelectorAll('.osbtn[data-os]'));");
    j("function pickPane(name) {");
    j("  panes.forEach(function (p) { p.classList.toggle('active', p.getAttribute('data-os') === name); });");
    j("  osbtns.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-os') === name); });");
    j("}");
    j("osbtns.forEach(function (b) {");
    j("  b.addEventListener('click', function () { pickPane(b.getAttribute('data-os')); });");
    j("});");
    j("if (OS !== 'windows') { pickPane(OS); }");
    j("");
    j("/* ---------- big download button ---------- */");
    j("var dlbtn = document.getElementById('dlbtn');");
    j("var dlhint = document.getElementById('dlhint');");
    j("if (dlbtn) {");
    j("  if (OS === 'linux') {");
    j("    dlbtn.href = 'downloads/york-x86_64-linux.tar.gz';");
    j("    dlbtn.textContent = 'Download for Linux';");
    j("    if (dlhint) { dlhint.textContent = 'Auto-detected: Linux · york-x86_64-linux.tar.gz · SHA-256 verified.'; }");
    j("  } else if (OS === 'macos') {");
    j("    dlbtn.href = '#install';");
    j("    dlbtn.textContent = 'macOS — coming soon';");
    j("    if (dlhint) { dlhint.textContent = 'Windows and Linux binaries are ready today. macOS is produced on a Mac and lands here next.'; }");
    j("  } else {");
    j("    dlbtn.href = 'downloads/york-setup-x64.exe';");
    j("    dlbtn.textContent = 'Download for Windows';");
    j("    if (dlhint) { dlhint.textContent = 'Auto-detected: Windows · york-setup-x64.exe · SHA-256 verified.'; }");
    j("  }");
    j("}");
    j("");
    j("/* ---------- code viewer tabs ---------- */");
    j("var tabs = Array.prototype.slice.call(document.querySelectorAll('.codewin .tab'));");
    j("var snips = Array.prototype.slice.call(document.querySelectorAll('.snipp'));");
    j("tabs.forEach(function (t) {");
    j("  t.addEventListener('click', function () {");
    j("    tabs.forEach(function (x) { x.classList.remove('active'); });");
    j("    snips.forEach(function (s) { s.classList.remove('active'); });");
    j("    t.classList.add('active');");
    j("    var target = t.getAttribute('data-snip');");
    j("    snips.forEach(function (s) { if (s.getAttribute('data-snip') === target) { s.classList.add('active'); } });");
    j("  });");
    j("});");
    j("");
    j("/* ---------- copy buttons ---------- */");
    j("function copyText(text, btn) {");
    j("  var done = function () {");
    j("    var old = btn.textContent;");
    j("    btn.textContent = 'copied!';");
    j("    btn.classList.add('done');");
    j("    setTimeout(function () { btn.textContent = old; btn.classList.remove('done'); }, 1400);");
    j("  };");
    j("  if (navigator.clipboard && navigator.clipboard.writeText) {");
    j("    navigator.clipboard.writeText(text).then(done, function () { fallback(text, btn, done); });");
    j("  } else { fallback(text, btn, done); }");
    j("}");
    j("function fallback(text, btn, done) {");
    j("  var ta = document.createElement('textarea');");
    j("  ta.value = text;");
    j("  ta.style.position = 'fixed';");
    j("  ta.style.opacity = '0';");
    j("  document.body.appendChild(ta);");
    j("  ta.select();");
    j("  try { document.execCommand('copy'); done(); } catch (e) { btn.textContent = 'press ctrl+c'; }");
    j("  document.body.removeChild(ta);");
    j("}");
    j("Array.prototype.slice.call(document.querySelectorAll('.copy')).forEach(function (b) {");
    j("  b.addEventListener('click', function () {");
    j("    var pre = b.parentElement.querySelector('pre');");
    j("    copyText(pre.textContent.trim(), b);");
    j("  });");
    j("});");
    j("");
    j("/* ---------- hero typing demo ---------- */");
    j("var hero = document.getElementById('heroterm');");
    j("if (hero) {");
    j("  var tape = [");
    j("    'public static void main(String[] args) {',");
    j("    '    Arena<Player> players = new Arena(1000);',");
    j("    '    players.push(Player { pos: 1.0, hp: 100.0 });',");
    j("    '',");
    j("    '    for (Player p : players) {',");
    j("    '        p.damage(10.0);',");
    j("    '        println(p.hp);',");
    j("    '    }',");
    j("    '}'");
    j("  ];");
    j("  var cursor = document.createElement('span');");
    j("  cursor.className = 'cursor';");
    j("  var li = 0, ci = 0;");
    j("  var tick = 13;");
    j("  var move = true;");
    j("  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { move = false; }");
    j("  function typeLine() {");
    j("    if (li >= tape.length) { showRun(); return; }");
    j("    var line = tape[li];");
    j("    if (ci < line.length) {");
    j("      hero.appendChild(document.createTextNode(line.charAt(ci)));");
    j("      ci++;");
    j("      if (move) { setTimeout(typeLine, tick); } else { while (ci < line.length) { hero.appendChild(document.createTextNode(line.charAt(ci))); ci++; } typeLine(); }");
    j("    } else {");
    j("      hero.appendChild(document.createTextNode(NL));");
    j("      li++; ci = 0;");
    j("      if (move) { setTimeout(typeLine, 130); } else { typeLine(); }");
    j("    }");
    j("  }");
    j("  function showRun() {");
    j("    hero.appendChild(document.createTextNode(NL));");
    j("    var d = document.createElement('span');");
    j("    d.className = 'dim';");
    j("    d.textContent = '$ york run hello.yk';");
    j("    hero.appendChild(d);");
    j("    hero.appendChild(document.createTextNode(NL));");
    j("    var o = document.createElement('span');");
    j("    o.className = 'out';");
    j("    o.textContent = 'Hello, York!';");
    j("    hero.appendChild(o);");
    j("  }");
    j("  hero.appendChild(cursor);");
    j("  window.setTimeout(typeLine, 350);");
    j("}");
    j("");
    j("/* ---------- reveal on scroll ---------- */");
    j("var secs = Array.prototype.slice.call(document.querySelectorAll('section, .stats, .download'));");
    j("secs.forEach(function (s) { s.classList.add('reveal'); });");
    j("if ('IntersectionObserver' in window) {");
    j("  var io = new IntersectionObserver(function (es) {");
    j("    es.forEach(function (e) {");
    j("      if (e.isIntersecting) {");
    j("        var i = secs.indexOf(e.target) % 3;");
    j("        e.target.style.transitionDelay = (i * 90) + 'ms';");
    j("        e.target.classList.add('show');");
    j("        io.unobserve(e.target);");
    j("      }");
    j("    });");
    j("  }, { threshold: 0.08 });");
    j("  secs.forEach(function (s) { io.observe(s); });");
    j("} else { secs.forEach(function (s) { s.classList.add('show'); }); }");
    j("");
    j("/* ---------- nav scroll state · burger · back-to-top ---------- */");
    j("var nav = document.getElementById('nav');");
    j("var links = document.getElementById('links');");
    j("var burger = document.getElementById('burger');");
    j("var topbtn = document.getElementById('topbtn');");
    j("function onScroll() {");
    j("  var y = window.pageYOffset || document.documentElement.scrollTop;");
    j("  if (nav) { nav.classList.toggle('scrolled', y > 16); }");
    j("  if (topbtn) { topbtn.classList.toggle('on', y > 560); }");
    j("}");
    j("window.addEventListener('scroll', onScroll, { passive: true });");
    j("onScroll();");
    j("if (burger && links) {");
    j("  burger.addEventListener('click', function () { links.classList.toggle('open'); });");
    j("  Array.prototype.slice.call(links.querySelectorAll('a')).forEach(function (a) {");
    j("    a.addEventListener('click', function () { links.classList.remove('open'); });");
    j("  });");
    j("}");
    j("if (topbtn) {");
    j("  topbtn.addEventListener('click', function () {");
    j("    window.scrollTo({ top: 0, behavior: 'smooth' });");
    j("  });");
    j("}");
    j("})();");
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------
public static void main(String[] args) {
    write_file("index.html", "");
    scripts();
    head();
    nav();
    hero();
    ticker();
    stats();
    features();
    codeview();
    learn();
    quickstart();
    install();
    cli();
    faq();
    footer();
    println("Site written to index.html");
}