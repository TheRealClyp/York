    line("  font-weight: bold;");
    line("  margin-bottom: 0.2rem;");
    line("}");
    line("");
    line("/* Popups */");
    line("dialog {");
    line("  max-width: 90%;");
    line("  max-height: 85dvh;");
    line("  margin: auto;");
    line("  padding-block: 0;");
    line("  padding-inline: 20px;");
    line("  border: 1px solid var(--color-bg-secondary);");
    line("  border-radius: 0.5rem;");
    line("  overscroll-behavior: contain;");
    line("  scroll-behavior: smooth;");
    line("  scrollbar-width: none; /* Hide scrollbar for Firefox */");
    line("  -ms-overflow-style: none; /* Hide scrollbar for IE and Edge */");
    line("  scrollbar-color: transparent transparent;");
    line("  animation: bottom-to-top 0.25s ease-in-out forwards;");
    line("}");
    line("");
    line("dialog::-webkit-scrollbar {");
    line("  width: 0;");
    line("  display: none;");
    line("}");
