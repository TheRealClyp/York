    line("");
    line("");
    line("/* MVP.css v1.18 - MIT License - github.com/andybrewer/mvp - base stylesheet */");
    line("/* ============ York site layer (sits on top of MVP.css) ============ */");
    line(":root{--font-mono:ui-monospace,SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;--color-link:#1a5dff;--color-accent:#e3ebff;--color-bg-secondary:#f0f2f5;--color-table:#1a5dff}");
    line("@media (prefers-color-scheme: dark){:root[color-mode='user']{--color-link:#79a8ff;--color-accent:#1e2c47;--color-bg-secondary:#272b31;--color-table:#79a8ff}}");
    line("main,header,footer{max-width:1060px}");
    line("nav{margin-bottom:2.2rem;flex-wrap:wrap;gap:.5rem}");
    line("/* ---------- nav ---------- */");
    line(".nav{position:sticky;top:0;z-index:60;display:flex;align-items:center;justify-content:flex-start;gap:1.1rem;background:var(--color-bg);border-bottom:1px solid transparent;transition:box-shadow .3s,border-color .3s;margin-bottom:0;padding:0.9rem 0}");
    line(".nav.scrolled{box-shadow:0 6px 18px var(--color-shadow);border-color:var(--color-bg-secondary)}");
    line(".nav .logo{display:flex;align-items:center;gap:.5rem;font-weight:800;font-size:1.2rem;color:var(--color-text);text-decoration:none}");
    line(".nav .logo .dot{color:var(--color-link)}");
    line(".links{display:flex;gap:.2rem;align-items:center}");
    line(".links a{color:var(--color-text-secondary);text-decoration:none;font-size:.92rem;font-weight:600;padding:.4rem .6rem;border-radius:6px}");
    line(".links a:hover{color:var(--color-link);text-decoration:none}");
    line(".nav .spacer{flex:1}");
    line(".nav .ver{border:1px solid var(--color-bg-secondary);border-radius:999px;padding:.15rem .7rem;font-size:.72rem;color:var(--color-link);font-family:var(--font-mono)}");
    line(".nav .cta{background:var(--color-link);color:var(--color-bg);border:2px solid var(--color-link);border-radius:8px;padding:.55rem 1.1rem;font-weight:bold;text-decoration:none;font-size:.9rem}");
    line(".nav .cta:hover{filter:brightness(1.15);text-decoration:none}");
    line(".burger{display:none;background:none;border:1px solid var(--color-bg-secondary);color:var(--color-text);border-radius:8px;padding:.5rem .8rem;font-size:1rem;cursor:pointer}");
    line("@media(max-width:820px){.links{position:absolute;top:100%;left:0;right:0;display:none;flex-direction:column;align-items:flex-start;background:var(--color-bg);padding:1rem 1.4rem;border-bottom:1px solid var(--color-bg-secondary)}.links.open{display:flex}.burger{display:inline-block}.nav .ver,.nav .cta{display:none}.nav{position:relative}}");
    line("/* ---------- hero ---------- */");
    line(".hero{text-align:center;padding:2.2rem 0 1rem}");
    line(".kicker{display:inline-block;border:1px solid var(--color-bg-secondary);border-radius:999px;padding:.4rem .95rem;font-size:.76rem;color:var(--color-text-secondary);letter-spacing:.4px;text-transform:uppercase}");
    line(".kicker em{color:var(--color-link);font-style:normal;font-weight:bold}");
    line(".kicker b{color:var(--color-text)}");
    line(".hero h1{font-size:clamp(2.5rem,7vw,4.6rem);letter-spacing:-1.5px;margin:.4em 0 .25em;text-wrap:balance}");
    line(".grad{color:var(--color-link)}");
    line(".hero p.lead{color:var(--color-text-secondary);max-width:44rem;margin:0 auto 1.4rem;font-size:1.08rem}");
    line(".buttons{display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap}");
    line(".btn{display:inline-block;border-radius:8px;padding:.75rem 1.6rem;font-weight:bold;text-decoration:none;color:var(--color-bg);background:var(--color-link);border:2px solid var(--color-link);margin:.5rem 0}");
    line("a.btn:hover{filter:brightness(1.15);text-decoration:none}");
    line(".btn.ghost{background:none;color:var(--color-link)}");
    line(".chips{display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap;margin-top:1.4rem}");
    line(".chip{border:1px solid var(--color-bg-secondary);border-radius:999px;padding:.35rem .85rem;font-size:.8rem;color:var(--color-text-secondary);background:var(--color-bg)}");
    line(".chip b{color:var(--color-text)}");
    line("/* ---------- hero terminal ---------- */");
    line(".term{max-width:52rem;margin:2.2rem auto 0;text-align:left;border:1px solid var(--color-bg-secondary);border-radius:10px;overflow:hidden;box-shadow:var(--box-shadow) var(--color-shadow);background:var(--color-bg)}");
    line(".term .tbar{display:flex;align-items:center;gap:.45rem;padding:.6rem .9rem;border-bottom:1px solid var(--color-bg-secondary);background:var(--color-bg-secondary)}");
    line(".term .tbar .dot{width:.68rem;height:.68rem;border-radius:50%;display:inline-block}");
    line(".term .tbar .name{color:var(--color-text-secondary);font-family:var(--font-mono);font-size:.75rem;margin-left:.6rem}");
    line(".term pre{margin:0;padding:1rem 1.3rem;font-family:var(--font-mono);font-size:.86rem;line-height:1.6;white-space:pre;overflow-x:auto;min-height:200px;color:var(--color-text);max-width:none}");
    line(".term .out{color:var(--color-link);font-weight:bold}");
    line(".term .dim{color:var(--color-text-secondary)}");
    line(".cursor{display:inline-block;width:8px;height:1.05em;background:var(--color-link);vertical-align:-2px;animation:blink 1.05s steps(1) infinite}");
    line("@keyframes blink{50%{opacity:0}}");
    line("/* ---------- ticker ---------- */");
    line(".ticker{overflow:hidden;border-top:1px solid var(--color-bg-secondary);border-bottom:1px solid var(--color-bg-secondary);background:var(--color-bg-secondary);padding:.9rem 0;margin-top:2.8rem}");
    line(".ticker .wrap{display:flex;gap:3rem;white-space:nowrap;width:max-content;animation:scroll 34s linear infinite}");
    line(".ticker span{font-family:var(--font-mono);color:var(--color-text-secondary);font-size:.82rem}");
    line(".ticker span b{color:var(--color-text)}");
    line(".ticker span em{font-style:normal;color:var(--color-link)}");
    line("@keyframes scroll{to{transform:translateX(-50%)}}");
    line("/* ---------- stats ---------- */");
    line(".stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;max-width:1040px;margin:0 auto;padding:3rem 0 .5rem}");
    line(".stat{text-align:center;padding:1.5rem .75rem;border:1px solid var(--color-bg-secondary);border-radius:10px;background:var(--color-bg)}");
    line(".stat .n{font-size:2.2rem;font-weight:800;color:var(--color-link)}");
    line(".stat .l{color:var(--color-text-secondary);font-size:.84rem;margin-top:.25rem}");
    line("@media(max-width:720px){.stats{grid-template-columns:1fr 1fr}}");
    line("/* ---------- sections & cards ---------- */");
    line("section{padding:4.4rem clamp(.8rem,4vw,2.5rem);max-width:1100px;margin:0 auto}");
    line(".eyebrow{text-align:center;font-family:var(--font-mono);font-size:.74rem;color:var(--color-link);letter-spacing:2.2px;text-transform:uppercase;margin-bottom:.8rem}");
    line("section h2{font-size:clamp(1.6rem,3.5vw,2.3rem);text-align:center;letter-spacing:-.5px;margin-bottom:.6rem;line-height:1.15;text-wrap:balance}");
    line("section .desc{color:var(--color-text-secondary);text-align:center;max-width:42rem;margin:0 auto 2.6rem;font-size:1.02rem}");
    line(".grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.1rem}");
    line(".card{border:1px solid var(--color-bg-secondary);border-radius:10px;padding:1.5rem;background:var(--color-bg);box-shadow:var(--box-shadow) var(--color-shadow)}");
    line(".card .icon{width:2.5rem;height:2.5rem;border-radius:8px;display:grid;place-items:center;background:var(--color-accent);color:var(--color-link);margin-bottom:.9rem}");
    line(".card .icon svg{width:1.3rem;height:1.3rem}");
    line(".card h3{margin-bottom:.4rem;font-size:1.05rem}");
    line(".card p{color:var(--color-text-secondary);font-size:.94rem}");
    line("/* ---------- code viewer ---------- */");
    line(".codewin{max-width:54rem;margin:0 auto;border:1px solid var(--color-bg-secondary);border-radius:10px;background:var(--color-bg);overflow:hidden;box-shadow:var(--box-shadow) var(--color-shadow)}");
    line(".codewin .tabs{display:flex;gap:.25rem;padding:.6rem .9rem;background:var(--color-bg-secondary);border-bottom:1px solid var(--color-bg-secondary);overflow-x:auto}");
    line(".codewin .tab{border:none;background:none;color:var(--color-text-secondary);font-family:var(--font-mono);font-size:.78rem;padding:.45rem .85rem;border-radius:6px;cursor:pointer;white-space:nowrap;margin:0}");
    line(".codewin .tab.active{background:var(--color-link);color:var(--color-bg);font-weight:bold}");
    line(".snipp{display:none;margin:0;padding:1.2rem 1.4rem;font-family:var(--font-mono);font-size:.85rem;line-height:1.65;color:var(--color-text);overflow-x:auto;max-height:560px;min-width:0;width:auto;max-width:100%}");
    line(".snipp.active{display:block}");
    line("pre .k,pre .t,pre .f{font-weight:bold}");
    line("pre .s{color:var(--color-link)}");
    line("pre .c{color:var(--color-text-secondary);font-style:italic}");
    line("pre .u{color:var(--color-text-secondary)}");
    line("pre .dim{color:var(--color-text-secondary)}");
    line("/* ---------- learn ---------- */");
    line(".lcard{display:flex;align-items:center;gap:.9rem;border:1px solid var(--color-bg-secondary);border-radius:10px;padding:1rem 1.2rem;background:var(--color-bg);box-shadow:var(--box-shadow) var(--color-shadow)}");
    line("a.lcard:hover{text-decoration:none;border-color:var(--color-link)}");
    line(".lcard .f{font-family:var(--font-mono);font-size:.78rem;color:var(--color-link);white-space:nowrap}");
    line(".lcard .t{flex:1;min-width:0}");
    line(".lcard .t b{display:block;color:var(--color-text);font-size:.95rem}");
    line(".lcard .t span{color:var(--color-text-secondary);font-size:.85rem}");
    line(".lcard .ar{color:var(--color-text-secondary)}");
    line("/* ---------- quickstart ---------- */");
    line(".qs .step{display:flex;gap:1rem;align-items:flex-start;margin-bottom:1.5rem;max-width:48rem;margin-left:auto;margin-right:auto}");
    line(".qs .step .num{flex:0 0 2.4rem;height:2.4rem;border-radius:8px;background:var(--color-accent);border:1px solid var(--color-bg-secondary);color:var(--color-link);font-weight:800;display:grid;place-items:center}");
    line(".qs .step p{color:var(--color-text-secondary);font-size:.95rem;margin-bottom:.6rem}");
    line(".cmdrow{display:flex;gap:.6rem;margin-top:.4rem}");
    line(".cmdrow pre{flex:1;background:var(--color-bg-secondary);border:1px solid var(--color-bg-secondary);border-radius:8px;padding:.7rem 1rem;font-family:var(--font-mono);font-size:.84rem;color:var(--color-text);margin:0;overflow-x:auto;min-width:0;max-width:100%}");
    line(".copy{background:var(--color-link);border:2px solid var(--color-link);color:var(--color-bg);border-radius:8px;padding:.55rem .9rem;font-family:var(--font-mono);font-size:.74rem;font-weight:bold;cursor:pointer;white-space:nowrap}");
    line(".copy.done{background:var(--color-bg-secondary);border-color:var(--color-bg-secondary);color:var(--color-text-secondary)}");
    line("/* ---------- install ---------- */");
    line(".download{text-align:center;border:1px solid var(--color-bg-secondary);border-radius:14px;padding:2.6rem 1.5rem;background:var(--color-bg)}");
    line(".dlbtn{display:inline-block;background:var(--color-link);color:var(--color-bg);border:2px solid var(--color-link);border-radius:8px;padding:1rem 2.4rem;font-size:1.1rem;font-weight:bold;text-decoration:none}");
    line("a.dlbtn:hover{filter:brightness(1.15);text-decoration:none}");
    line(".dlsmall{color:var(--color-text-secondary);margin-top:1rem;font-size:.88rem}");
    line(".dlrow{display:flex;gap:.55rem;justify-content:center;flex-wrap:wrap;margin-top:1.2rem}");
    line(".mini{border:1px solid var(--color-bg-secondary);border-radius:8px;color:var(--color-text);padding:.55rem .95rem;font-size:.84rem;font-family:var(--font-mono);text-decoration:none;background:var(--color-bg);margin:.2rem 0;font-weight:normal}");
    line("a.mini:hover{border-color:var(--color-link);text-decoration:none}");
    line(".relband{max-width:52rem;margin:0 auto 1.5rem;text-align:center;border:1px solid var(--color-bg-secondary);color:var(--color-text-secondary);font-size:.84rem;padding:.55rem 1rem;border-radius:999px}");
    line(".relband b{color:var(--color-link)}");
    line(".ostabs{display:flex;gap:.4rem;justify-content:center;margin:2rem 0 1.2rem;flex-wrap:wrap}");
    line(".osbtn{background:var(--color-bg);border:1px solid var(--color-bg-secondary);color:var(--color-text-secondary);padding:.55rem 1.3rem;border-radius:8px;font-weight:600;cursor:pointer;font-size:.9rem;margin:0}");
    line(".osbtn:hover{filter:brightness(1.06)}");
    line(".osbtn.active{background:var(--color-link);border-color:var(--color-link);color:var(--color-bg);font-weight:bold}");
    line(".pane{display:none;background:var(--color-bg);border:1px solid var(--color-bg-secondary);border-radius:12px;padding:1.6rem}");
    line(".pane.active{display:block}");
    line(".pane h3{margin-bottom:.3rem}");
    line(".pane .note{color:var(--color-text-secondary);font-size:.92rem;margin-bottom:1rem}");
    line(".dltable{width:100%;border-collapse:collapse;margin-top:.7rem;font-size:.9rem;display:table}");
    line(".dltable th{text-align:left;color:var(--color-text-secondary);font-weight:600;padding:.55rem .7rem;border-bottom:1px solid var(--color-bg-secondary);font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;background:none}");
    line(".dltable td{padding:.7rem;border-bottom:1px solid var(--color-bg-secondary);color:var(--color-text);vertical-align:middle;text-align:left;white-space:normal}");
    line(".dltable td b{color:var(--color-text)}");
    line(".dltable .sub{color:var(--color-text-secondary);font-size:.78rem;display:block;margin-top:2px}");
    line(".dltable .sz{color:var(--color-text-secondary);white-space:nowrap;font-family:var(--font-mono);font-size:.8rem}");
    line(".cardwrap{display:flex;gap:.55rem;justify-content:flex-end}");
    line("@media(max-width:640px){.dltable{display:block;overflow-x:auto;white-space:nowrap}}");
    line(".sha{color:var(--color-text-secondary);font-size:.78rem;margin-top:1.2rem;text-align:center}");
    line("/* ---------- faq ---------- */");
    line(".faq details{border:1px solid var(--color-bg-secondary);background:var(--color-bg);border-radius:10px;padding:1rem 1.2rem;margin-bottom:.7rem;box-shadow:var(--box-shadow) var(--color-shadow)}");
    line(".faq summary{cursor:pointer;font-weight:bold;list-style:none;color:var(--color-text)}");
    line(".faq details p{margin-top:.7rem;color:var(--color-text-secondary);font-size:.94rem}");
    line("/* ---------- footer & extras ---------- */");
    line(".footer{border-top:1px solid var(--color-bg-secondary);padding:2.6rem 1rem 2rem;text-align:center;color:var(--color-text-secondary);font-size:.88rem}");
    line(".footer .flinks{display:flex;gap:1.2rem;justify-content:center;flex-wrap:wrap;margin-bottom:1rem}");
    line(".footer .flinks a{color:var(--color-text-secondary)}");
    line(".footer .meta{font-family:var(--font-mono);color:var(--color-text-secondary);font-size:.76rem;margin-top:.7rem}");
    line(".footer .made{color:var(--color-link)}");
    line("#topbtn{position:fixed;right:1.4rem;bottom:1.4rem;z-index:70;width:2.8rem;height:2.8rem;border-radius:8px;border:1px solid var(--color-bg-secondary);background:var(--color-bg);color:var(--color-link);font-size:1.1rem;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .25s}");
    line("#topbtn.on{opacity:1;pointer-events:auto}");
    line(".reveal{opacity:0;transform:translateY(22px);transition:opacity .5s ease,transform .5s ease}");
    line(".reveal.show{opacity:1;transform:none}");
    line("@media(prefers-reduced-motion:reduce){.ticker .wrap{animation:none}.reveal{opacity:1;transform:none}.cursor{animation:blink 1.4s steps(1) infinite}}");
    line("</style>");
    line("</head>");
    line("<body>");
}

