// York mobile app template.
// Build with:  york mobile src/app.yk --out build
// The program below generates a mobile web app (index.html) + its JS.
// `york mobile` then wraps it into an installable PWA and an Android shell.

public static void w(String s) {
    append_file("index.html", s);
    append_file("index.html", "\n");
}

public static void js(String s) {
    append_file("app.js", s);
    append_file("app.js", "\n");
}

public static void head() {
    w("<!DOCTYPE html>");
    w("<html lang='en'>");
    w("<head>");
    w("<meta charset='utf-8'>");
    w("<meta name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover'>");
    w("<title>York Habits</title>");
    w("<style>");
    w(":root { --bg:#04070d; --card:#0b1220; --text:#e2e8f0; --muted:#64748b; --accent:#22d3ee; --accent2:#818cf8; }");
    w("* { box-sizing:border-box; }");
    w("body { margin:0; font-family:-apple-system,'Segoe UI',Roboto,sans-serif; background:var(--bg); color:var(--text); padding-bottom:80px; }");
    w("header { position:sticky; top:0; background:rgba(4,7,13,.92); backdrop-filter:blur(8px); padding:18px 20px 12px; border-bottom:1px solid #1e293b; }");
    w("header h1 { margin:0; font-size:22px; }");
    w("header p { margin:4px 0 0; color:var(--muted); font-size:13px; }");
    w("main { padding:16px; max-width:560px; margin:0 auto; }");
    w(".card { background:var(--card); border:1px solid #1e293b; border-radius:16px; padding:16px; margin-bottom:14px; }");
    w(".card h2 { margin:0 0 10px; font-size:16px; color:var(--accent); }");
    w("button { background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#04070d; border:0; border-radius:10px; font-weight:700; font-size:15px; padding:11px 16px; margin-right:8px; width:100%; }");
    w("button:active { transform:scale(.98); }");
    w("input { width:100%; background:#0f172a; border:1px solid #1e293b; color:#e2e8f0; border-radius:10px; padding:12px; font-size:16px; margin-bottom:10px; }");
    w(".row { display:flex; gap:8px; }");
    w(".row button { flex:1; }");
    w(".counter { font-size:52px; font-weight:800; text-align:center; color:var(--accent); margin:8px 0; }");
    w(".muted { color:var(--muted); font-size:13px; }");
    w("footer { position:fixed; bottom:0; left:0; right:0; display:flex; border-top:1px solid #1e293b; background:var(--bg); }");
    w("footer .tab { flex:1; text-align:center; padding:12px 0 8px; color:var(--muted); font-size:12px; }");
    w("footer .tab.active { color:var(--accent); }");
    w("</style>");
    w("</head>");
    w("<body>");
    w("<header><h1>York Habits</h1><p>a tiny app written in York &middot; build &amp; ship once</p></header>");
    w("<main id='page-home'>");
    w("<div class='card'><h2>Counter</h2><div class='counter' id='count'>0</div>");
    w("<div class='row'><button onclick='dec()'>-1</button><button onclick='inc()'>+1</button></div></div>");
    w("<div class='card'><h2>Add a habit</h2><input id='habit' placeholder='e.g. drink water'>");
    w("<button onclick='addHabit()'>Add habit</button><ul id='list' class='muted' style='margin-top:12px;padding-left:18px'></ul></div>");
    w("<div class='card'><h2>About</h2><p class='muted'>Everything on this screen is generated by a York program and packaged by `york mobile` into a home-screen installable app, an Android APK, and an iOS Xcode project.</p>");
    w("<div class='row' style='margin-top:10px'><button onclick='showDevice()'>Device</button><button onclick='shareApp()'>Share</button></div>");
    w("<p class='muted' id='device-info' style='margin-top:10px'></p></div>");
    w("</main>");
    w("<footer><div class='tab active'>Home</div><div class='tab'>Stats</div><div class='tab'>You</div></footer>");
    w("<script src='app.js'></script>");
    w("</body>");
    w("</html>");
}

public static void mjs() {
    js("// York Habits — app logic");
    js("var count = 0;");
    js("function inc() { count++; document.getElementById('count').innerText = count; York.vibrate(30); if (window.York) York.storage.set('habits_count', count); }");
    js("function dec() { count--; document.getElementById('count').innerText = count; if (window.York) York.storage.set('habits_count', count); }");
    js("function addHabit() {");
    js("  var v = document.getElementById('habit').value.trim();");
    js("  if (!v) return;");
    js("  var li = document.createElement('li'); li.innerText = v; li.style.listStyle='none';");
    js("  document.getElementById('list').appendChild(li);");
    js("  document.getElementById('habit').value = '';");
    js("  if (window.York) York.toast('Habit added');");
    js("}");
    js("function shareApp() {");
    js("  if (window.York) York.share('York Habits', 'Made with York — write once, ship to Play + App Store.', '');");
    js("  else alert('Made with York — write once, ship to Play + App Store.');");
    js("}");
    js("function showDevice() {");
    js("  if (window.York) {");
    js("    Promise.all([York.network.get(), York.battery.get()]).then(function(r){");
    js("      document.getElementById('device-info').innerText = 'network: ' + r[0].type + ' (' + (r[0].online ? 'online' : 'offline') + ')  ·  battery: ' + Math.round((r[1].level || 0) * 100) + '% ' + (r[1].charging ? 'charging' : '');");
    js("    });");
    js("  } else { document.getElementById('device-info').innerText = 'run as a mobile app to see device features'; }");
    js("}");
    js("document.addEventListener('click', function(e){ var t = e.target.closest('footer .tab'); if (!t) return; document.querySelectorAll('footer .tab').forEach(function(x){ x.classList.remove('active'); }); t.classList.add('active'); });");
    js("if (window.York) { York.ready(function(){ York.storage.get('habits_count').then(function(v){ if (v !== null) { count = Number(v) || 0; document.getElementById('count').innerText = count; } }); }); }");
}

public static void main(String[] args) {
    head();
    mjs();
}